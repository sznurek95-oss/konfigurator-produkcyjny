{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konfigurator produkcyjny",
  "version": "0.3.0",
  "identifier": "pl.twojaszuflada.konfigurator",
  "build": {
    "frontendDist": "../dist/app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Konfigurator produkcyjny",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "TwojaSzuflada.pl",
    "shortDescription": "Konfigurator produkcyjny",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Polish"]
      }
    }
  }
}
